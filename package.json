{
  "name": "webengineering",
  "version": "1.0.0",
  "type": "module",
  "description": "This repository is designed as the foundation for coding playgrounds in the Web Engineering course. It offers a structured space for experimenting with and mastering various web development technologies and practices.  The project is based on [this](https://developer.mozilla.org/en-US/docs/Learn/Accessibility/Accessibility_troubleshooting) repository from MDN.",
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace @bears/api\" \"npm run dev --workspace @bears/web\"",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "preview": "npm run preview --workspace @bears/web",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces",
    "prepare": "husky",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api"
  },
  "lint-staged": {
    "apps/*/src/**/*": "prettier --write",
    "apps/*/src/**/*.{ts,tsx}": "eslint --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.7",
    "eslint-config-love": "^157.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.2"
  },
  "private": true,
  "workspaces": [
    "apps/*"
  ]
}
